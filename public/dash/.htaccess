# TeachNet — закрытый дашборд /dash. CSP и прочие заголовки — из корневого .htaccess.
DirectoryIndex index.php
Options -Indexes

<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>

# lib.php — только для подключения из index.php / api.php, по HTTP закрыт
<Files "lib.php">
    Require all denied
</Files>

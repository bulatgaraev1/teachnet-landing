# Стили и скрипты лендингов /holiday/ и /pcb/ — без хеша в имени, поэтому браузер сверяется с сервером
# при каждом заходе (ответ 304 без загрузки, если файл не менялся): после деплоя все сразу видят новую версию.
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
